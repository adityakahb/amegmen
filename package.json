{
  "name": "amegmen",
  "version": "2.0.0",
  "description": "AMegMen — Keyboard and screen reader accessible mega menu — TypeScript, zero dependencies",
  "license": "Apache-2.0",
  "author": "Adobe Accessibility",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/scripts/amegmen.cjs.js",
  "module": "./dist/scripts/amegmen.esm.js",
  "exports": {
    ".": {
      "import": "./dist/scripts/amegmen.esm.js",
      "require": "./dist/scripts/amegmen.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/styles/amegmen.css": "./dist/styles/amegmen.css"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:css && npm run build:cdn",
    "build:cdn": "vite build --config vite-cdn.config.ts",
    "build:pages": "npm run build && vite build --config vite-pages.config.ts",
    "build:css": "node scripts/build-css.mjs",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"demos/**/*.{html,ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"demos/**/*.{html,ts,js}\"",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:fix": "npm run lint:ts:fix && npm run lint:css:fix",
    "lint:ts": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:ts:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "lint:css": "stylelint \"src/css/**/*.css\"",
    "lint:css:fix": "stylelint \"src/css/**/*.css\" --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@vitest/ui": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^24.1.0",
    "prettier": "^3.0.0",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.3.0",
    "vite-plugin-dts": "^3.9.0",
    "vitest": "^2.0.0"
  }
}
